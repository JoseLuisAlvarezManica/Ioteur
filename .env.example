# ── General ────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Auth Service (PostgreSQL) ───────────────────────────────
POSTGRES_AUTH_USER=change_me_auth_user
POSTGRES_AUTH_PASSWORD=change_me_auth_pass
POSTGRES_AUTH_DB=change_me_auth_db
POSTGRES_AUTH_DATABASE_URL=postgresql+asyncpg://change_me_auth_user:change_me_auth_pass@postgres-auth:5432/change_me_auth_db

# ── Auth Service (Redis) ────────────────────────────────────
REDIS_AUTH_URL=redis://redis-auth:6379/0

# ── Device Service (PostgreSQL) ─────────────────────────────
POSTGRES_DEVICE_USER=change_me_device_user
POSTGRES_DEVICE_PASSWORD=change_me_device_pass
POSTGRES_DEVICE_DB=change_me_device_db
POSTGRES_DEVICE_DATABASE_URL=postgresql+asyncpg://change_me_device_user:change_me_device_pass@postgres-device:5432/change_me_device_db

# ── Device Service (Redis) ──────────────────────────────────
REDIS_DEVICE_URL=redis://redis_device:6379/0

# ── Service URLs ────────────────────────────────────────────
AUTH_SERVICE_URL=http://auth-service:8001
CALL_SERVICE_URL=http://call-service:8002
DEVICE_SERVICE_URL=http://device-service:8003
REGISTER_SERVICE_URL=http://register-service:8005
TELEMETRY_SERVICE_URL=http://telemetry-service:8006
API_GATEWAY_URL=http://api-gateway:8000

# ── JWT ─────────────────────────────────────────────────────
PRIVATE_KEY=insert_your_private_key_here
PUBLIC_KEY=insert_your_public_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Internal service key ────────────────────────────────────
INTERNAL_API_KEY=changeme-internal-secret-2026

# ── RabbitMQ ────────────────────────────────────────────────
RABBITMQ_USER=change_me_rabbit_user
RABBITMQ_PASSWORD=change_me_rabbit_password
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://change_me_rabbit_user:change_me_rabbit_password@rabbitmq:5672/

# ── Register Service (MongoDB) ──────────────────────────────
MONGO_REGISTER_USER=change_me_register_user
MONGO_REGISTER_PASSWORD=change_me_register_pass
MONGO_REGISTER_DB=change_me_register_db
MONGO_REGISTER_URL=mongodb://change_me_register_user:change_me_register_pass@mongo_register:27017/change_me_register_db?authSource=admin

# ── Telemetry Service (MongoDB) ──────────────────────────────
MONGO_TELEMETRY_USER=change_me_telemetry_user
MONGO_TELEMETRY_PASSWORD=change_me_telemetry_pass
MONGO_TELEMETRY_DB=change_me_telemetry_db
MONGO_TELEMETRY_URL=mongodb://change_me_telemetry_user:change_me_telemetry_pass@mongo_telemetry:27017/change_me_telemetry_db?authSource=admin

# ── Notifications Service (MongoDB) ──────────────────────────────
MONGO_NOTIFICATIONS_USER=change_me_notifications_user
MONGO_NOTIFICATIONS_PASSWORD=change_me_notifications_pass
MONGO_NOTIFICATIONS_DB=change_me_notifications_db
MONGO_NOTIFICATIONS_URL=mongodb://change_me_notifications_user:change_me_notifications_pass@mongo_notifications:27017/change_me_notifications_db?authSource=admin

# ── EmailJS REST API ──────────────────────────────
EMAILJS_URL=https://api.emailjs.com/api/v1.0/email/send
EMAILJS_SERVICE_ID=change_me_emailjs_service_id
EMAILJS_TEMPLATE_ID=change_me_emailjs_template_id
EMAILJS_PUBLIC_KEY=change_me_emailjs_public_key
EMAILJS_PRIVATE_KEY=change_me_emailjs_private_key

# ── Scheduler ──────────────────────────────
SCHEDULER_INTERVAL_SECONDS= 120